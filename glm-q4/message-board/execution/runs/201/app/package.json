{
  "name": "realtime-message-board",
  "version": "1.0.0",
  "description": "A simple message board with real-time updates using PGLite and Server-Sent Events",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch backend/server.js",
    "dev:client": "cd frontend && npm run dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.4.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
