root ::= tool-call
space ::= | " " | "\n"{1,2} [ \t]{0,20}
tool-call ::= "<tool_call>" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish) space "</tool_call>" (space "<tool_call>" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish) space "</tool_call>")* space
tool-edit-file ::= (("" "edit_file" "") space) tool-edit-file-arg-path space tool-edit-file-arg-old-str space tool-edit-file-arg-new-str
tool-edit-file-arg-new-str ::= ("<arg_key>" "new_str" "</arg_key>") "<arg_value>" ac-199
tool-edit-file-arg-old-str ::= ("<arg_key>" "old_str" "</arg_key>") "<arg_value>" ac-178
tool-edit-file-arg-path ::= ("<arg_key>" "path" "</arg_key>") "<arg_value>" ac-157
tool-finish ::= ("" "finish" "") space (space (tool-finish-arg-summary))*
tool-finish-arg-summary ::= ("<arg_key>" "summary" "</arg_key>") "<arg_value>" ac-307
tool-list-dir ::= ("" "list_dir" "") space (space (tool-list-dir-arg-path))*
tool-list-dir-arg-path ::= ("<arg_key>" "path" "</arg_key>") "<arg_value>" ac-255
tool-read-file ::= (("" "read_file" "") space) tool-read-file-arg-path
tool-read-file-arg-path ::= ("<arg_key>" "path" "</arg_key>") "<arg_value>" ac-33
tool-write-file ::= (("" "write_file" "") space) tool-write-file-arg-path space tool-write-file-arg-content
tool-write-file-arg-content ::= ("<arg_key>" "content" "</arg_key>") "<arg_value>" ac-104
tool-write-file-arg-path ::= ("<arg_key>" "path" "</arg_key>") "<arg_value>" ac-83
