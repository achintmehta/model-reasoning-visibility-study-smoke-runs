 }\n\n    .input-container {\n      padding: 20px;\n      background: #fafafa;\n    }\n\n    .input-container textarea {\n      width: 100%;\n      padding: 16px;\n      border: 2px solid #e0e0e0;\n      border-radius: 8px;\n      font-size: 1rem;\n      font-family: inherit;\n      resize: vertical;\n      min-height: 80px;\n      transition: border-color 0.2s;\n      outline: none;\n    }\n\n    .input-container textarea:focus {\n      border-color: #667eea;\n    }\n\n    .input-container textarea:disabled {\n      background: #f5f5f5;\n    }\n\n    .submit-btn {\n      margin-top: 12px;\n      padding: 12px 24px;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      color: white;\n      border: none;\n      border-radius: 8px;\n      font-size: 1rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: transform 0.2s, box-shadow 0.2s;\n      width: 100%;\n    }\n\n    .submit-btn:hover:not(:disabled) {\n      transform: translateY(-2px);\n      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);\n    }\n\n    .submit-btn:active:not(:disabled) {\n      transform: translateY(0);\n    }\n\n    .submit-btn:disabled {\n      opacity: 0.5;\n      cursor: not-allowed;\n    }\n\n    .status-indicator {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px;\n      font-size: 0.85rem;\n      color: #666;\n    }\n\n    .status-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      margin-right: 8px;\n    }\n\n    .status-dot.connected {\n      background: #4caf50;\n      animation: pulse 2s infinite;\n    }\n\n    .status-dot.disconnected {\n      background: #f44336;\n    }\n\n    @keyframes fadeIn {\n      from {\n        opacity: 0;\n        transform: translateY(10px);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    @keyframes pulse {\n      0%, 100% {\n        opacity: 1;\n      }\n      50% {\n        opacity: 0.5;\n      }\n    }\n\n    .error {\n      color: #f44336;\n      text-align: center;\n      padding: 12px;\n      background: #ffebee;\n      border-radius: 8px;\n      margin-bottom: 12px;\n      font-size: 0.9rem;\n    }\n\n    /* Custom scrollbar */\n    .messages-container::-webkit-scrollbar {\n      width: 8px;\n    }\n\n    .messages-container::-webkit-scrollbar-track {\n      background: #f1f1f1;\n    }\n\n    .messages-container::-webkit-scrollbar-thumb {\n      background: #c1c1c1;\n      border-radius: 4px;\n    }\n\n    .messages-container::-webkit-scrollbar-thumb:hover {\n      background: #a1a1a1;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <header>\n      <h1>Real-Time Message Board</h1>\n      <p>Post messages and see them appear instantly on all connected clients</p>\n    </header>\n\n    <div class=\"status-indicator\">\n      <span class=\"status-dot disconnected\" id=\"statusDot\"></span>\n      <span id=\"statusText\">Connecting...</span>\n    </div>\n\n    <div class=\"messages-container\" id=\"messagesContainer\">\n      <div class=\"empty-state\">\n        <p>Loading messages...</p>\n      </div>\n    </div>\n\n    <div class=\"input-container\">\n      <textarea\n        id=\"messageInput\"\n        placeholder=\"Write your message...\"\n        maxlength=\"500\"\n      ></textarea>\n      <button class=\"submit-btn\" id=\"submitBtn\">Post Message</button>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    const messagesContainer = document.getElementById('messagesContainer');\n    const messageInput = document.getElementById('messageInput');\n    const submitBtn = document.getElementById('submitBtn');\n    const statusDot = document.getElementById('statusDot');\n    const statusText = document.getElementById('statusText');\n\n    let eventSource = null;\n\n    // Format message for display\n    function formatMessage(message) {\n      return `\n        <div class=\"message\">\n          <div class=\"message-header\">\n            <span class=\"message-time\">${message.display_time}</span>\n          </div>\n          <div class=\"message-text\">${escapeHtml(message.text)}</div>\n        </div>\n      `;\n    }\n\n    // Escape HTML to prevent XSS\n    function escapeHtml(text) {\n      const div = document.createElement('div');\n      div.textContent = text;\n      return div.innerHTML;\n    }\n\n    // Add message to the UI\n    function addMessage(message) {\n      const messageHtml = formatMessage(message);\n      messagesContainer.insertAdjacentHTML('afterbegin', messageHtml);\n    }\n\n    // Render initial messages\n    async function loadMessages() {\n      try {\n        const response = await fetch('/api/messages');\n        const messages = await response.json();\n\n        messagesContainer.innerHTML = '';\n        messages.forEach(message => {\n          addMessage(message);\n        });\n      } catch (error) {\n        console.error('Error loading messages:', error);\n        messagesContainer.innerHTML = `\n          <div class=\"error\">\n            Failed to load messages. Please refresh the page.\n          </div>\n        `;\n      }\n    }\n\n    // Connect to SSE stream\n    function connectToStream() {\n      eventSource = new EventSource('/api/stream');\n\n      eventSource.addEventListener('message', (event) => {\n        const message = JSON.parse(event.data);\n        addMessage(message);\n      });\n\n      eventSource.addEventListener('error', (error) => {\n        console.error('SSE error:', error);\n        updateStatus('disconnected', 'Disconnected');\n      });\n\n      eventSource.onopen = () => {\n        updateStatus('connected', 'Connected');\n      };\n    }\n\n    // Handle form submission\n    async function handleSubmit() {\n      const text = messageInput.value.trim();\n\n      if (!text) {\n        messageInput.focus();\n        return;\n      }\n\n      try {\n        submitBtn.disabled = true;\n        submitBtn.textContent = 'Posting...';\n\n        const response = await fetch('/api/messages', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n          },\n          body: JSON.stringify({ text }),\n        });\n\n        if (!response.ok) {\n          throw new Error('Failed to post message');\n        }\n\n        const message = await response.json();\n        addMessage(message);\n\n        messageInput.value = '';\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Post Message';\n      } catch (error) {\n        console.error('Error posting message:', error);\n        messageInput.value = '';\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Post Message';\n\n        alert('Failed to post message. Please try again.');\n      }\n    }\n\n    // Update status indicator\n    function updateStatus(status, text) {\n      statusDot.className = `status-dot ${status}`;\n      statusText.textContent = text;\n    }\n\n    // Event listeners\n    submitBtn.addEventListener('click', handleSubmit);\n\n    messageInput.addEventListener('keydown', (e) => {\n      if (e.key === 'Enter' && !e.shiftKey) {\n        e.preventDefault();\n        handleSubmit();\n      }\n    });\n\n    messageInput.addEventListener('input', () => {\n      submitBtn.disabled = messageInput.value.trim() === '';\n    });\n\n    // Initialize\n    loadMessages();\n    connectToStream();\n  </script>\n</body>\n</html>\n"})
