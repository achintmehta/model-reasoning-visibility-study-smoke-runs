json-value ::= json-object | json-array | json-string | json-number | json-bool | json-null
root ::= tool-call
space ::= | " " | "\n"{1,2} [ \t]{0,20}
tool-call ::= "<tool_call>" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish | tool-run-command | tool-run-background-command | tool-run-command-and-capture-output | tool-list-background-commands | tool-stop-background-command) space "</tool_call>" (space "<tool_call>" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish | tool-run-command | tool-run-background-command | tool-run-command-and-capture-output | tool-list-background-commands | tool-stop-background-command) space "</tool_call>")* space
