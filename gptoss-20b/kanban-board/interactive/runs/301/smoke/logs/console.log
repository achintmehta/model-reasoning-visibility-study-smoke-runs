Tool Call: write_file({"path": "backend/db.js", "content": "const { PGLite } = require('@electric-sql/pglite');\nconst path = require('path');\n\n// Use relative path to store the db file in backend/data\nconst dbPath = path.join(__dirname, 'data', 'pglite.db');\nconst db = new PGLite({ path: dbPath });\n\nasync function init() {\n  // Create tables if they don't exist\n  await db.exec(`\n    CREATE TABLE IF NOT EXISTS columns (\n      id TEXT PRIMARY KEY,\n      title TEXT NOT NULL,\n      position INTEGER NOT NULL\n    );\n\n    CREATE TABLE IF NOT EXISTS cards (\n      id TEXT PRIMARY KEY,\n      column_id TEXT NOT NULL REFERENCES columns(id) ON DELETE CASCADE,\n      text TEXT,\n      position INTEGER NOT NULL,\n      created_at TEXT DEFAULT (datetime('now','localtime'))\n    );\n  `);\n\n  // Seed default columns if table empty\n  const res = await db.get(`SELECT COUNT(*) as count FROM columns`);\n  if (res.count === 0) {\n    await db.exec(`\n      INSERT INTO columns (id, title, position) VALUES\n        (\"1\", \"To Do\", 1),\n        (\"2\", \"In Progress\", 2),\n        (\"3\", \"Done\", 3);\n    `);\n  }\n}\n\nexports.db = db;\nexports.init = init;\n"})
