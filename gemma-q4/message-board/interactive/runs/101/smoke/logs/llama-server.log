1.42.912.962 D srv    operator(): Grammar (tool_calls): gemma4-array ::= "[" space ("]" | gemma4-value ("," space gemma4-value)* space "]")
gemma4-bool ::= json-bool
gemma4-dict ::= "{" space ("}" | gemma4-dict-kv ("," space gemma4-dict-kv)* space "}")
gemma4-dict-key ::= gemma4-dict-key-name ":"
gemma4-dict-key-name ::= [^:}]+
gemma4-dict-kv ::= gemma4-dict-key space gemma4-value
gemma4-null ::= json-null
gemma4-number ::= json-number
gemma4-string ::= "<|\"|>" gemma4-string-content "<|\"|>"
gemma4-string-content ::= until-28
gemma4-value ::= gemma4-string | gemma4-dict | gemma4-array | gemma4-number | gemma4-bool | gemma4-null
json-bool ::= "true" | "false"
json-null ::= "null"
json-number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? (("e" | "E") [+-]? [0-9]+)?
root ::= tool-call
space ::= | " " | "\n"{1,2} [ \t]{0,20}
tool-browser-click ::= ("browser_click") gemma4-dict
tool-browser-close-page ::= ("browser_close_page") gemma4-dict
tool-browser-drag ::= ("browser_drag") gemma4-dict
tool-browser-navigate ::= ("browser_navigate") gemma4-dict
tool-browser-new-page ::= ("browser_new_page") gemma4-dict
tool-browser-read ::= ("browser_read") gemma4-dict
tool-browser-switch-page ::= ("browser_switch_page") gemma4-dict
tool-browser-type ::= ("browser_type") gemma4-dict
tool-browser-wait ::= ("browser_wait") gemma4-dict
tool-call ::= ("<|tool_call>call:" (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish | tool-run-command | tool-run-background-command | tool-run-command-and-capture-output | tool-list-background-commands | tool-stop-background-command | tool-browser-navigate | tool-browser-click | tool-browser-type | tool-browser-drag | tool-browser-read | tool-browser-wait | tool-browser-new-page | tool-browser-switch-page | tool-browser-close-page) "<tool_call|>")*
tool-edit-file ::= ("edit_file") gemma4-dict
