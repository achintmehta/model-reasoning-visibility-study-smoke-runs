ew Error('Failed to send message');\\n    }\\n\\n    messageInput.value = '';\\n  } catch (error) {\\n    console.error('Error sending message:', error);\\n    alert('Error sending message. Please try again.');\\n  }\\n});\\n\\n// Initialize\\nloadMessages();\\nsetupSSE();\\n\",\"path\":\"frontend/main.js\"}"}}]}
