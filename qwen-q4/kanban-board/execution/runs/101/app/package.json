{
  "name": "kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative Kanban board with PGLite and SSE",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
