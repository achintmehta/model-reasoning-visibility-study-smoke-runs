rm: translateY(-8px); }\\n      to { opacity: 1; transform: translateY(0); }\\n    }\\n\\n    .message .meta {\\n      font-size: 0.75rem;\\n      color: #999;\\n      margin-bottom: 6px;\\n    }\\n\\n    .message .text {\\n      word-wrap: break-word;\\n      line-height: 1.5;\\n    }\\n\\n    .form-container {\\n      position: sticky;\\n      bottom: 0;\\n      background: #f5f5f5;\\n      padding: 16px 0 0;\\n      border-top: 1px solid #e0e0e0;\\n    }\\n\\n    #message-form {\\n      display: flex;\\n      gap: 8px;\\n    }\\n\\n    #message-input {\\n      flex: 1;\\n      padding: 12px 16px;\\n      border: 2px solid #ddd;\\n      border-radius: 8px;\\n      font-size: 1rem;\\n      font-family: inherit;\\n      outline: none;\\n      transition: border-color 0.2s;\\n    }\\n\\n    #message-input:focus {\\n      border-color: #4a90d9;\\n    }\\n\\n    #submit-btn {\\n      padding: 12px 24px;\\n      background: #4a90d9;\\n      color: #fff;\\n      border: none;\\n      border-radius: 8px;\\n      font-size: 1rem;\\n      font-weight: 600;\\n      cursor: pointer;\\n      transition: background 0.2s;\\n    }\\n\\n    #submit-btn:hover {\\n      background: #3a7bc8;\\n    }\\n\\n    #submit-btn:disabled {\\n      background: #aaa;\\n      cursor: not-allowed;\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div class=\\\"container\\\">\\n    <header>\\n      <h1>📋 Message Board</h1>\\n      <p>Real-time collaborative messaging</p>\\n    </header>\\n\\n    <div id=\\\"status\\\" class=\\\"status disconnected\\\">Connecting...</div>\\n\\n    <ul id=\\\"message-list\\\" class=\\\"empty\\\"></ul>\\n\\n    <div class=\\\"form-container\\\">\\n      <form id=\\\"message-form\\\">\\n        <input\\n          type=\\\"text\\\"\\n          id=\\\"message-input\\\"\\n          placeholder=\\\"Type a message...\\\"\\n          maxlength=\\\"500\\\"\\n          autocomplete=\\\"off\\\"\\n        />\\n        <button type=\\\"submit\\\" id=\\\"submit-btn\\\">Send</button>\\