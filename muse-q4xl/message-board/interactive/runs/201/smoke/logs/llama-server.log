vite build\",\n    \"preview\": \"vite preview\"\n  },\n  \"devDependencies\": {\n    \"vite\": \"^5.0.0\"\n  }\n}\n\nNo extra deps.\n\nCreate backend/server.js.\n\nImplementation details:\n\nimport express from 'express';\nimport cors from 'cors';\nimport { PGlite } from '@electric-sql/pglite';\nimport fs from 'fs';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst DATA_DIR = path.join(__dirname, 'data');\nif (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });\n\nconst dbPath = path.join(DATA_DIR, 'pglite.db');\n\nconst app = express();\napp.use(cors());\napp.use(express.json());\n\nlet db;\nlet clients = [];\n\nasync function initDb() {\n  db = new PGlite(`file:${dbPath}`);\n  await db.waitReady;\n  await db.exec(`\n    CREATE TABLE IF NOT EXISTS messages (\n      id SERIAL PRIMARY KEY,\n      text TEXT NOT NULL,\n      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()\n    );\n  `);\n}\n...\n\nBut PGlite constructor returns instance. The API: new PGlite('file:...') returns promise? In docs, PGlite is a class, constructor returns instance, and you need to await db.waitReady? Might need await db.exec. Let's assume.\n\nSimpler: const db = await PGlite.create(...)? Actually check typical usage: import { PGlite } from '@electric-sql/pglite'; const db = await PGlite.create('file:...'); Not sure.\n\nLet's search mental: PGlite docs: const db = await PGlite.create('file://...'); Hmm.\n\nAlternatively, maybe use new PGlite(). Let's check example: According to ElectricSQL pglite, usage is:\nimport { PGlite } from '@electric-sql/pglite';\nconst db = await PGlite.create('file:./data/db.sqlite');\nawait db.exec('CREATE TABLE ...');\n\nSome docs say constructor returns promise.\n\nLet's assume new PGlite returns instance immediately, and db.waitReady resolves.\n\nWe'll implement defensively.\n\nWe'll create initDb async IIFE.\n\nEndpoints:\n\napp.get('/api/messages', async (req, res) => {\n  try {\n    const result = await db.query('SELECT id, text, created_at FROM messages ORDER BY created_at ASC');\n    res.json(result.rows);\n  } catch...\n});\n\napp.post('/api/messages', async (req, res) => {\n  const { text } = req.body;\n  if (!text || typeof text !== 'string' || text.trim() === '') return res.status(400).json({ error: 'text required' });\n  try {\n    const result = await db.query('INSERT INTO messages (text) VALUES ($1) RETURNING id, text, created_at', [text.trim()]);\n    const msg = result.rows[0];\n    broadcast(msg);\n    res.status(201).json(msg);\n  } catch...\n});\n\nSSE:\n\napp.get('/api/stream', (req, res) => {\n  res.setHeader('Content-Type', 'text/event-stream');\n  res.setHeader('Cache-Control', 'no-cache');\n  res.setHeader('Connection', 'keep-alive');\n  res.setHeader('X-Accel-Buffering', 'no');\n  res.flushHeaders();\n\n  // send comment to keep connection alive\n  const heartbeat = setInterval(() => {\n    res.write(': heartbeat\\n\\n');\n  }, 30000);\n\n  const client = { res };\n  clients.push(client);\n\n  req.on('close', () => {\n    clearInterval(heartbeat);\n    clients = clients.filter(c => c !== client);\n  });\n\n  // send initial ping\n  res.write('event: connected\\ndata: connected\\n\\n');\n});\n\nbroadcast(msg):\nclients.forEach(c => {\n  try { c.res.write(`event: message\\ndata: ${JSON.stringify(msg)}\\n\\n`); } catch {}\n});\n\nEdge cases: db query returns rows. Might need to handle.\n\nMake sure server listens on port 3000.\n\nFrontend:\n\nindex.html:\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Message Board</title>\n</head>\n<body>\n  <div id=\"app\">\n    <h1>Message Board</h1>\n    <ul id=\"messages\"></ul>\n    <form id=\"message-form\">\n      <input id=\"message-input\" type=\"text\" placeholder=\"Enter message\" required />\n      <button type=\"submit\">Send</button>\n    </form>\n  </div>\n  <script type=\"module\" src=\"/src/main.js\"></script>\n</body>\n</html>\n\nsrc/main.js:\nconst messagesEl = document.getElementById('messages');\nconst form = document.getElementById('message-form');\nconst input = document.getElementById('message-input');\n\nconst API_BASE = 'http://localhost:3000/api';\n\nasync function loadMessages() {\n  const res = await fetch(`${API_BASE}/messages`);\n  const msgs = await res.json();\n  messagesEl.innerHTML = '';\n  msgs.forEach(renderMessage);\n}\n\nfunction renderMessage(msg) {\n  const li = document.createElement('li');\n  li.textContent = `${new Date(msg.created_at).toLocaleString()}: ${msg.text}`;\n  li.dataset.id = msg.id;\n  messagesEl.appendChild(li);\n}\n\nform.addEventListener('submit', async (e) => {\n  e.preventDefault();\n  const text = input.value.trim();\n  if (!text) return;\n  await fetch(`${API_BASE}/messages`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ text })\n  });\n  input.value = '';\n});\n\nconst es = new EventSource(`${API_BASE}/stream`);\nes.addEventListener('message', (e) => {\n  const msg = JSON.parse(e.data);\n  renderMessage(msg);\n});\n\nloadMessages();\n\nAdd basic style? Optional.\n\nvite.config.js:\nimport { defineConfig } from 'vite';\nexport default defineConfig({\n  root: '.',\n  server: {\n    port: 5173\n  }\n});\n\nBut Vite by default looks for index.html at root. Our frontend folder contains index.html at root of folder. Good.\n\nNow implement files.\n\nLet's start creating directory structure.\n\nFirst list_dir to confirm empty.\n\nWe already did. Now write files.\n\nWe need to create backend folder.\n\nLet's use write_file to create root package.json.\n\nProceed step by step.\n\nFirst write root package.json.","tool_calls":[{"type":"function","function":{"name":"write_file","arguments":"{\"path\":\"/tmp/runs/smokes/muse-q4xl/message-board/interactive/runs/201/app/pa