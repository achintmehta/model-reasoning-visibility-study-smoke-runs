ingify({ text }),\\n        });\\n\\n        if (response.ok) {\\n            messageInput.value = '';\\n        } else {\\n            console.error('Error posting message:', response.statusText);\\n        }\\n    } catch (error) {\\n        console.error('Error posting message:', error);\\n    }\\n});\\n\\n// Initial load\\nfetchMessages();\\nsetupSSE();\\n\",\"path\":\"frontend/main.js\"}"}}]}
