nd && npm install && cd frontend && npm install\\\",\\n    \\\"start\\\": \\\"cd backend && node src/server.js\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"concurrently\\\": \\\"^8.2.0\\\"\\n  }\\n}\"}"}}]}
