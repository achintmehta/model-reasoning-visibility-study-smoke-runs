root ::= tool-call
space ::= | " " | "\n"{1,2} [ \t]{0,20}
tool-call ::= "<seed:tool_call>\n" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish) space "</seed:tool_call>" (space "<seed:tool_call>\n" space (tool-read-file | tool-write-file | tool-edit-file | tool-list-dir | tool-finish) space "</seed:tool_call>")* space
tool-edit-file ::= ("<function=" "edit_file" ">\n") space tool-edit-file-arg-path space tool-edit-file-arg-old-str space tool-edit-file-arg-new-str space "</function>\n"
tool-edit-file-arg-new-str ::= ("<parameter=" "new_str" ">") "" ac-200
tool-edit-file-arg-old-str ::= ("<parameter=" "old_str" ">") "" ac-179
tool-edit-file-arg-path ::= ("<parameter=" "path" ">") "" ac-158
tool-finish ::= ("<function=" "finish" ">\n") space (space (tool-finish-arg-summary))* space "</function>\n"
tool-finish-arg-summary ::= ("<parameter=" "summary" ">") "" ac-307
tool-list-dir ::= ("<function=" "list_dir" ">\n") space (space (tool-list-dir-arg-path))* space "</function>\n"
tool-list-dir-arg-path ::= ("<parameter=" "path" ">") "" ac-255
tool-read-file ::= ("<function=" "read_file" ">\n") space tool-read-file-arg-path space "</function>\n"
tool-read-file-arg-path ::= ("<parameter=" "path" ">") "" ac-36
tool-write-file ::= ("<function=" "write_file" ">\n") space tool-write-file-arg-path space tool-write-file-arg-content space "</function>\n"
tool-write-file-arg-content ::= ("<parameter=" "content" ">") "" ac-106
tool-write-file-arg-path ::= ("<parameter=" "path" ">") "" ac-85
