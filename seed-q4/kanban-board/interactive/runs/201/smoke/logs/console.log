Tool Call: write_file({"path": "/tmp/runs/smokes/seed-q4/kanban-board/interactive/runs/201/app/kanban-board/src/sse.js", "content": "let clients = new Set();\n\nexport function initSSE(req, res) {\n  const headers = {\n    'Content-Type': 'text/event-stream',\n    'Cache-Control': 'no-cache',\n    'Connection': 'keep-alive'\n  };\n  \n  res.writeHead(200, headers);\n  \n  const clientId = Date.now();\n  const client = res;\n  \n  clients.add(client);\n  \n  // Send a comment every 15 seconds to keep the connection alive\n  const keepAliveInterval = setInterval(() => {\n    client.write(': keep-alive\\n\\n');\n  }, 15000);\n  \n  client.on('close', () => {\n    clients.delete(client);\n    clearInterval(keepAliveInterval);\n  });\n  \n  return clientId;\n}\n\nexport function broadcastEvent(eventType, data) {\n  const eventData = JSON.stringify(data);\n  \n  for (const client of clients) {\n    try {\n      client.write(`event: ${eventType}\\n`);\n      client.write(`data: ${eventData}\\n\\n`);\n    } catch (error) {\n      clients.delete(client);\n    }\n  }\n}"})
