olumn\n      const maxResult = await tx.query(\n        'SELECT MAX(position) FROM cards WHERE column_id = $1',\n        [targetColumnId]\n      );\n      const maxPosition = maxResult.rows[0]?.max ? parseFloat(maxResult.rows[0].max) : null;\n      \n      newPosition = maxPosition ? maxPosition + 1 : 1;\n    }\n    \n    // Insert the card in its new position\n    await tx.exec(\n      'INSERT INTO cards (id, column_id, text, position) VALUES ($1, $2, $3, $4)',\n      [cardId, targetColumnId, card.text, newPosition]\n    );\n    \n    // Return the updated card\n    const updatedResult = await tx.query('SELECT * FROM cards WHERE id = $1', [cardId]);\n    return updatedResult.rows[0];\n  });\n}"})
