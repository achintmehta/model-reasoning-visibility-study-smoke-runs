{
  "name": "kanban-board",
  "version": "1.0.0",
  "description": "Collaborative Kanban Board with PGLite and SSE",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "install": "cd frontend && npm install",
    "dev:backend": "node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
