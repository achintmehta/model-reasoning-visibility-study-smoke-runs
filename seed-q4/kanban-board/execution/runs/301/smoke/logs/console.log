Tool Call: write_file({"path": "kanban-board/server.js", "content": "import express from 'express';\nimport cors from 'cors';\nimport path from 'path';\nimport fs from 'fs';\nimport fsPromises from 'fs/promises';\nimport { fileURLToPath } from 'url';\nimport { v4 as uuidv4 } from 'uuid';\nimport { PGlite } from '@electric-sql/pglite';\n\n// Get __dirname for ES modules\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Create necessary directories\nconst DATA_DIR = path.join(__dirname, 'pglite-data');\nconst FRONTEND_PUBLIC = path.join(__dirname, 'frontend', 'public');\n\n// Store active SSE connections\nconst sseClients = new Set();\n\n// Initialize Express app\nconst app = express();\napp.use(cors());\napp.use(express.json());\n\n// Serve static files from frontend/public\napp.use(express.static(FRONTEND_PUBLIC));\n\n// Serve index.html for all other routes to support client-side routing\napp.get('*', (req, res) => {\n  res.sendFile(path.join(FRONTEND_PUBLIC, 'index.html'));\n});\n\n// Initialize PGLite with file system persistence\nlet db;\nasync function initDB() {\n  try {\n    // Create data directory if it doesn't exist\n    try {\n      await fsPromises.access(DATA_DIR);\n    } catch {\n      await fsPromises.mkdir(DATA_DIR, { recursive: true });\n      console.log('Created PGLite data directory at', DATA_DIR);\n    }\n\n    // Initialize PGLite\n    db = new PGlite({\n      path: path.join(DATA_DIR, 'kanban.db')\n    });\n\n    // Create tables and seed data\n    await createTables();\n    await seedInitialData();\n    console.log('Database initialized successfully');\n  } catch (error) {\n    console.error('Error initializing database:', error);\n    throw error;\n  }\n}\n\n// Create database tables\nasync function createTables() {\n  try {\n    await db.sql`\n      CREATE TABLE IF NOT EXISTS columns (\n        id TEXT PRIMARY KEY,\n        title TEXT NOT NULL,\n        position INTEGER NOT NULL DEFAULT 0\n      );\n    `;\n\n    await db.sql`\n      CREATE TABLE IF NOT EXISTS cards (\n        id TEXT PRIMARY KEY,\n        column_id TEXT NOT NULL REFERENCES columns(id),\n        text TEXT NOT NULL,\n        position NUMERIC NOT NULL DEFAULT 0,\n        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n        FOREIGN KEY (column_id) REFERENCES columns(id) ON DELETE CASCADE\n      );\n    `;\n  } catch (error) {\n    console.error('Error creating tables:', error);\n    throw error;\n  }\n}\n\n// Seed initial column data\nasync function seedInitialData() {\n  try {\n    const columns = [\n      { id: 'todo', title: 'To Do', position: 0 },\n      { id: 'in-progress', title: 'In Progress', position: 1 },\n      { id: 'done', title: 'Done', position: 2 }\n    ];\n\n    for (const column of columns) {\n      await db.sql`\n        INSERT INTO columns (id, title, position)\n        VALUES (${column.id}, ${column.title}, ${column.position})\n        ON CONFLICT (id) DO NOTHING;\n      `;\n    }\n  } catch (error) {\n    console.error('Error seeding initial data:', error);\n    throw error;\n  }\n}\n\n// Helper function to broadcast events to all SSE clients\nfunction broadcastEvent(eventType, data) {\n  const eventData = JSON.stringify(data);\n  sseClients.forEach(client => {\n    client.write(`event: ${eventType}\\n`);\n    client.write(`data: ${eventData}\\n\\n`);\n  });\n}\n\n// Helper function to get the next available position in a column\nasync function getNextPosition(columnId) {\n  try {\n    const result = await db.sql`\n      SELECT position FROM cards WHERE column_id = ${columnId} ORDER BY position DESC LIMIT 1;\n    `;\n    \n    const rows = result.rows;\n    if (rows.length === 0) {\n      return 1; // First position in the column\n    }\n    \n    const lastPosition = rows[0].position;\n    \n    // Check for position collisions/exhaustion\n    if (lastPosition > 1000000) {\n      // Renormalize positions if they get too large\n      await renormalizePositions(columnId);\n      return 1;\n    }\n    \n    // Use a position between the last one and the one before it (if it exists)\n    const prevResult = await db.sql`\n      SELECT position FROM cards WHERE column_id = ${columnId} ORDER BY position DESC LIMIT 2 OFFSET 1;\n    `;\n    \n    const prevRows = prevResult.rows;\n    if (prevRows.length === 0) {\n      return lastPosition + 1;\n    }\n    \n    const prevPosition = prevRows[0].position;\n    return (prevPosition + lastPosition) / 2;\n  } catch (error) {\n    console.error('Error getting next position:', error);\n    throw error;\n  }\n}\n\n// Helper function to renormalize positions in a column\nasync function renormalizePositions(columnId) {\n  try {\n    const result = await db.sql`\n      SELECT id, position FROM cards WHERE column_id = ${columnId} ORDER BY position ASC;\n    `;\n    \n    const cards = result.rows;\n    for (let i = 0; i < cards.length; i++) {\n      await db.sql`\n        UPDATE cards \n        SET position = ${i + 1} \n        WHERE id = ${cards[i].id};\n      `;\n    }\n    \n    // Broadcast the updated column\n    const updatedColumn = await getColumnWithCards(columnId);\n    broadcastEvent('column-update', { column: updatedColumn });\n    \n    return cards.length;\n  } catch (error) {\n    console.error('Error renormalizing positions:', error);\n    throw error;\n  }\n}\n\n// Helper function to get a column with its cards\nasync function getColumnWithCards(columnId) {\n  try {\n    const columnResult = await db.sql`\n      SELECT id, title, position FROM columns WHERE id = ${columnId};\n    `;\n    \n    if (columnResult.rows.length === 0) {\n      return null;\n    }\n    \n    const column = columnResult.rows[0];\n    \n    const cardsResult = await db.sql`\n      SELECT id, text, position, created_at FROM cards WHERE column_id = ${columnId} ORDER BY position ASC;\n    `;\n    \n    return { ...column, cards: cardsResult.rows };\n  } catch (error) {\n    console.error('Error getting column with cards:', error);\n    throw error;\n  }\n}\n\n// API endpoint to get board state\napp.get('/api/board', async (req, res) => {\n  try {\n    const columnsResult = await db.sql`\n      SELECT id, title, position \n      FROM columns \n      ORDER BY position ASC;\n    `;\n\n    const columns = columnsResult.rows;\n    \n    // Get cards for each column, ordered by position\n    const columnsWithCards = await Promise.all(\n      columns.map(async column => {\n        const cardsResult = await db.sql`\n          SELECT id, text, position, created_at \n          FROM cards \n          WHERE column_id = ${column.id} \n          ORDER BY position ASC;\n        `;\n        return {\n          ...column,\n          cards: cardsResult.rows\n        };\n      })\n    );\n\n    res.json({ columns: columnsWithCards });\n  } catch (error) {\n    console.error('Error fetching board state:', error);\n    res.status(500).json({ error: 'Failed to fetch board state' });\n  }\n});\n\n// API endpoint to create a new card\napp.post('/api/cards', async (req, res) => {\n  try {\n    const { columnId, text } = req.body;\n    \n    if (!columnId || !text) {\n      return res.status(400).json({ error: 'columnId and text are required' });\n    }\n\n    // Start transaction\n    await db.begin();\n    \n    try {\n      // Get next position for the column\n      const position = await getNextPosition(columnId);\n      \n      // Create the card\n      const cardId = uuidv4();\n      await db.sql`\n        INSERT INTO cards (id, column_id, text, position)\n        VALUES (${cardId}, ${columnId}, ${text}, ${position});\n      `;\n      \n      // Commit transaction\n      await db.commit();\n      \n      // Get the full column with the new card\n      const column = await getColumnWithCards(columnId);\n      \n      // Broadcast the update\n      broadcastEvent('card-created', { columnId, column });\n      \n      // Return the created card\n      res.status(201).json({ id