LICT (id) DO NOTHING;\n    `;\n  }\n}\n\n// Helper function to broadcast events to all SSE clients\nfunction broadcastEvent(eventType, data) {\n  const eventData = JSON.stringify(data);\n  sseClients.forEach(client => {\n    client.write(`event: ${eventType}\\n`);\n    client.write(`data: ${eventData}\\n\\n`);\n  });\n}\n\n// Helper function to get the next available position in a column\nasync function getNextPosition(columnId) {\n  const result = await db.sql`\n    SELECT position FROM cards WHERE column_id = ${columnId} ORDER BY position DESC LIMIT 1;\n  `;\n  \n  const rows = result.rows;\n  if (rows.length === 0) {\n    return 1; // First position in the column\n  }\n  \n  const lastPosition = rows[0].position;\n  \n  // Check for position collisions/exhaustion\n  if (lastPosition > 1000000) {\n    // Renormalize positions if they get too large\n    await renormalizePositions(columnId);\n    return 1;\n  }\n  \n  // Use a position between the last one and the one before it (if it exists)\n  const prevResult = await db.sql`\n    SELECT position FROM cards WHERE column_id = ${columnId} ORDER BY position DESC LIMIT 2 OFFSET 1;\n  `;\n  \n  const prevRows = prevResult.rows;\n  if (prevRows.length === 0) {\n    return lastPosition + 1;\n  }\n  \n  const prevPosition = prevRows[0].position;\n  return (prevPosition + lastPosition) / 2;\n}\n\n// Helper function to renormalize positions in a column\nasync function renormalizePositions(columnId) {\n  const result = await db.sql`\n    SELECT id, position FROM cards WHERE column_id = ${columnId} ORDER BY position ASC;\n  `;\n  \n  const cards = result.rows;\n  for (let i = 0; i < cards.length; i++) {\n    await db.sql`\n      UPDATE cards \n      SET position = ${i + 1} \n      WHERE id = ${cards[i].id};\n    `;\n  }\n  \n  // Broadcast the updated column\n  const updatedColumn = await getColumnWithCards(columnId);\n  broadcastEvent('column-update', { column: updatedColumn });\n  \n  return cards.length;\n}\n\n// Helper function to get a column with its cards\nasync function getColumnWithCards(columnId) {\n  const columnResult = await db.sql`\n    SELECT id, title, position FROM columns WHERE id = ${columnId};\n  `;\n  \n  if (columnResult.rows.length === 0) {\n    return null;\n  }\n  \n  const column = columnResult.rows[0];\n  \n  const cardsResult = await db.sql`\n    SELECT id, text, position, created_at FROM cards WHERE column_id = ${columnId} ORDER BY position ASC;\n  `;\n  \n  return { ...column, cards: cardsResult.rows };\n}\n\n// API endpoint to get board state\napp.get('/api/board', async (req, res) => {\n  try {\n    const columnsResult = await db.sql`\n      SELECT id, title, position \n      FROM columns \n      ORDER BY position ASC;\n    `;\n\n    const columns = columnsResult.rows;\n    \n    // Get cards for each column, ordered by position\n    const columnsWithCards = await Promise.all(\n      columns.map(async column => {\n        const cardsResult = await db.sql`\n          SELECT id, text, position, created_at \n          FROM cards \n          WHERE column_id = ${column.id} \n          ORDER BY position ASC;\n        `;\n        return {\n          ...column,\n          cards: cardsResult.rows\n        };\n      })\n    );\n\n    res.json({ columns: columnsWithCards });\n  } catch (error) {\n    console.error('Error fetching board state:', error);\n    res.status(500).json({ error: 'Failed to fetch board state' });\n  }\n});\n\n// API endpoint to create a new card\napp.post('/api/cards', async (req, res) => {\n  try {\n    const { columnId, text } = req.body;\n    \n    if (!columnId || !text) {\n      return res.status(400).json({ error: 'columnId and text are required' });\n    }\n\n    // Start transaction\n    await db.begin();\n    \n    try {\n      // Get next position for the column\n      const position = await getNextPosition(columnId);\n      \n      // Create the card\n      const cardId = uuidv4();\n      await db.sql`\n        INSERT INTO cards (i