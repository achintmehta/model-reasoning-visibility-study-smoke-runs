 = ${columnId};\n        `;\n        const afterResult = await db.sql`\n          SELECT position FROM cards WHERE id = ${afterId} AND column_id = ${columnId};\n        `;\n        \n        if (beforeResult.rows.length === 0 || afterResult.rows.length === 0) {\n          await db.rollback();\n          return res.status(400).json({ error: 'Before or after card not found in target column' });\n        }\n        \n        position = (beforeResult.rows[0].position + afterResult.rows[0].position) / 2;\n      } else if (beforeId) {\n        // Before a specific card\n        const beforeResult = await db.sql`\n          SELECT position FROM cards WHERE id = ${beforeId} AND column_id = ${columnId};\n        `;\n        \n        if (beforeResult.rows.length === 0) {\n          await db.rollback();\n          return res.status(400).json({ error: 'Before card not found in target column' });\n        }\n        \n        position = beforeResult.rows[0].position - 0.1;\n      } else if (afterId) {\n        // After a specific card\n        const afterResult = await db.sql`\n          SELECT position FROM cards WHERE id = ${afterId} AND column_id = ${columnId};\n        `;\n        \n        if (afterResult.rows.length === 0) {\n          await db.rollback();\n          return res.status(400).json({ error: 'After card not found in target column' });\n        }\n        \n        position = afterResult.rows[0].position + 0.1;\n      } else {\n        // End of the column\n        position = await getNextPosition(columnId);\n      }\n      \n      // Remove card from source column if different\n      if (currentCard.column_id !== columnId) {\n        await db.sql`\n          DELETE FROM cards WHERE id = ${cardId};\n        `;\n      }\n      \n      // Add card to target column\n      await db.sql`\n        INSERT INTO cards (id, column_id, text, position)\n        VALUES (${cardId}, ${columnId}, ${currentCard.text}, ${position})\n        ON CONFLICT (id) DO UPDATE SET column_id = ${columnId}, position = ${position};\n      `;\n      \n      // Commit transaction\n      await db.commit();\n      \n      // Get the updated card\n      const updatedCardResult = await db.sql`\n        SELECT id, column_id, text, position FROM cards WHERE id = ${cardId};\n      `;\n      \n      const updatedCard = updatedCardResult.rows[0];\n      \n      // Get the source and target columns to broadcast\n      const sourceColumn = currentCard.column_id !== columnId \n        ? await getColumnWithCards(currentCard.column_id) \n        : null;\n      \n      const targetColumn = await getColumnWithCards(columnId);\n      \n      // Broadcast the move\n      broadcastEvent('card-moved', { \n        cardId, \n        sourceColumnId: currentCard.column_id, \n        targetColumnId: columnId,\n        sourceColumn,\n        targetColumn\n      });\n      \n      // Return the updated card\n      res.json(updatedCard);\n    } catch (error) {\n      // Rollback transaction on error\n      await db.rollback();\n      throw error;\n    }\n  } catch (error) {\n    console.error('Error moving card:', error);\n    res.status(500).json({ error: 'Failed to move card' });\n  }\n});\n\n// SSE endpoint to stream updates\napp.get('/api/stream', (req, res) => {\n  res.setHeader('Content-Type', 'text/event-stream');\n  res.setHeader('Cache-Control', 'no-cache');\n  res.setHeader('Connection', 'keep-alive');\n  \n  // Send initial heartbeat to keep connection alive\n  const heartbeatInterval = setInterval(() => {\n    res.write(':\\n\\n');\n  }, 30000);\n  \n  // Add client to the set\n  sseClients.add(res);\n  \n  // Handle client disconnect\n  req.on('close', () => {\n    clearInterval(heartbeatInterval);\n    sseClients.delete(res);\n  });\n});\n\n// Start server\nconst PORT = process.env.PORT || 3000;\ninitDB().then(() => {\n  app.listen(PORT, () => {\n    console.log(`Server running on port ${PORT}`);\n    console.log(`Frontend available at http://localhost:${PORT}`);\n  }