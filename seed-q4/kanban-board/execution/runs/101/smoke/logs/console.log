Now, let's create the frontend main JavaScript file (frontend/src/main.js):

```javascript
import { Dragula } from 'dragula';

// Initialize the board
async function initBoard() {
  const boardElement = document.getElementById('board');
  
  try {
    const response = await fetch('/api/board');
    const columns = await response.json();
    
    columns.forEach(column => {
      const columnElement = document.createElement('div');
      columnElement.className = 'column';
      columnElement.dataset.columnId = column.id;
      
      const headerElement = document.createElement('div');
      headerElement.className = 'column-header';
      headerElement.textContent = column.title;
      
      const cardListElement = document.createElement('div');
      cardListElement.className = 'card-list';
      cardListElement.dataset.columnId = column.id;
      
      column.cards.forEach(card => {
        const cardElement = createCardElement(card);
        cardListElement.appendChild(cardElement);
      });
      
      const inputElement = document.createElement('input');
      inputElement.className = 'add-card-input';
      inputElement.type = 'text';
      inputElement.placeholder = 'Add a card...';
      
      const buttonElement = document.createElement('button');
      buttonElement.className = 'add-card-button';
      buttonElement.textContent = 'Add Card';
      buttonElement.addEventListener('click', async () => {
        const text = inputElement.value.trim();
        if (text) {
          // Optimistically add the card to the UI
          const newCard = {
            id: Date.now(), // Temporary ID for optimistic rendering
            text: text,
            position: column.cards.length
          };
          
          const cardElement = createCardElement(newCard, true);
          cardListElement.appendChild(cardElement);
          inputElement.value = '';
          
          // Send request to server
          try {
            const response = await fetch('/api/cards', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ columnId: column.id, text: text })
            });
            
            const serverCard = await response.json();
            
            // Replace the optimistic card with the server's card
            cardElement.dataset.cardId = serverCard.id;
            cardElement.textContent = serverCard.text;
          } catch (error) {
            // If the request fails, remove the optimistic card
            cardElement.remove();
            console.error('Failed to create card:', error);
          }
        }
      });
      
      columnElement.appendChild(headerElement);
      columnElement.appendChild(cardListElement);
      columnElement.appendChild(inputElement);
      columnElement.appendChild(buttonElement);
      
      boardElement.appendChild(columnElement);
    });
    
    // Set up drag-and-drop
    setupDragAndDrop();
    
    // Set up SSE
    setupSSE();
  } catch (error) {
    console.error('Failed to load board:', error);
  }
}

// Create a card element
function createCardElement(card, isOptimistic = false) {
  const cardElement = document.createElement('div');
  cardElement.className = 'card';
  
  if (isOptimistic) {
    cardElement.dataset.tempId = card.id;
  } else {
    cardElement.dataset.cardId = card.id;
  }
  
  cardElement.textContent = card.text;
  
  return cardElement;
}

// Set up drag-and-drop
function setupDragAndDrop() {
  const cardLists = document.querySelectorAll('.card-list');
  
  if (cardLists.length === 0) return;
  
  const drake = Dragula([...cardLists], {
    revertOnSpill: true,
    copy: false,
    removeOnSpill: true
  });
  
  drake.on('drag', (el) => {
    el.classList.add('dragging');
  });
  
  drake.on('dragend', (el) => {
    el.classList.remove('dragging');
  });
  
  drake.on('drop', async (el, target, source, sibling) => {
    const cardId = el.dataset.cardId || el.dataset.tempId;
    const sourceColumnId = source.dataset.columnId;
    const targetColumnId = target.dataset.columnId;
    
    let beforeId = null;
    let afterId = null;
    
    if (sibling) {
      const siblingId = sibling.dataset.cardId || sibling.dataset.tempId;
      const cards = Array.from(target.children).map(child => ({
        id: child.dataset.cardId || child.dataset.tempId,
        element: child
      }));
      
      const siblingIndex = cards.findIndex(card => card.id === siblingId);
      
      if (siblingIndex > 0) {
        afterId = cards[siblingIndex - 1].id;
      }
      
      beforeId = siblingId;
    } else if (target.children.length === 0) {
      // Dropping at the end of an empty list
      beforeId = null;
      afterId = null;
    } else {
      // Dropping at the end of a non-empty list
      afterId = target.children[target.children.length - 1].dataset.cardId;
      beforeId = null;
    }
    
    // Optimistically update the UI
    const tempCard = {
      id: cardId,
      text: el.textContent
    };
    
    // Remove from source if it's not the same as target
    if (sourceColumnId !== targetColumnId) {
      const sourceElement = document.querySelector(`[data-column-id="${sourceColumnId}"] .card-list`);
      const cardElement = sourceElement.querySelector(`[data-card-id="${cardId}"]`);
      if (cardElement) {
        cardElement.remove();
      }
    }
    
    // Add to target
    target.appendChild(el);
    
    // Send request to server
    try {
      const response = await fetch(`/api/cards/${cardId}/move`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          columnId: targetColumnId,
          beforeId: beforeId,
          afterId: afterId
        })
      });
      
      const serverCard = await response.json();
      
      // Update the card with server data
      el.dataset.cardId = serverCard.id;
      el.textContent = serverCard.text;
    } catch (error) {
      // If the request fails, revert the optimistic update
      if (sourceColumnId !== targetColumnId) {
        const sourceElement = document.querySelector(`[data-column-id="${sourceColumnId}"] .card-list`);
        sourceElement.appendChild(el);
      } else {
        const cards = Array.from(target.children);
        const index = cards.indexOf(el);
        if (index > 0) {
          afterId = cards[index - 1].dataset.cardId;
        }
        beforeId = cards[index + 1] ? cards[index + 1].dataset.cardId : null;
        
        // This is a simplified approach - in a real app, you'd want to revert more accurately
        target.appendChild(el);
      }
      
      console.error('Failed to move card:', error);
    }
  });
}

// Set up SSE
function setupSSE() {
  const eventSource = new EventSource('/api/stream');
  
  eventSource.onmessage = (event) => {
    const data = JSON.parse(event.data);
    updateBoard(data);
  };
  
  eventSource.onerror = (error) => {
    console.error('SSE error:', error);
    eventSource.close();
    // Try to reconnect after a delay
    setTimeout(setupSSE, 3000);
  };
}

// Update the board with the latest state
function updateBoard(columns) {
  const boardElement = document.getElementById('board');
  
  // Clear existing columns (except for the add card inputs and buttons)
  const columnHeaders = boardElement.querySelectorAll('.column-header');
  columnHeaders.forEach(header => {
    const columnElement = header.parentElement;
    const inputElement = columnElement.querySelector('.add-card-input');
    const buttonElement = columnElement.querySelector('.add-card-button');
    
    // Remove all card elements
    const cardListElement = columnElement.querySelector('.card-list');
    cardListElement.innerHTML = '';
    
    // Add cards from the server
    const column = columns.find(c => c.id == columnElement.dataset.columnId);
    if (column) {
      column.cards.forEach(card => {
        const cardElement = createCardElement(card);
        cardListElement.appendChild(cardElement);
      });
    }
  });
}

// Initialize the board when the page loads
document.addEventListener('DOMContentLoaded', initBoard);
```

