```javascript
const express = require('express');
const cors = require('cors');
const { PGlite } = require('@electric-sql/pglite');
const path = require('path');
const fs = require('fs').promises;

const app = express();
const port = 3000;

// Middleware
app.use(cors());
app.use(express.json());

// Initialize PGlite
const dbPath = path.join(__dirname, '../db/data');
await fs.mkdir(dbPath, { recursive: true });
const db = new PGlite({ path: dbPath });

// Database initialization
async function initDB() {
  await db.exec(`
    CREATE TABLE IF NOT EXISTS columns (
      id SERIAL PRIMARY KEY,
      title TEXT NOT NULL,
      position NUMERIC NOT NULL DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS cards (
      id SERIAL PRIMARY KEY,
      column_id INTEGER NOT NULL REFERENCES columns(id) ON DELETE CASCADE,
      text TEXT NOT NULL,
      position NUMERIC NOT NULL DEFAULT 0,
      created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
    );

    INSERT INTO columns (title, position) VALUES 
      ('To Do', 0),
      ('In Progress', 1),
      ('Done', 2)
    ON CONFLICT DO NOTHING;
  `);
}

// SSE clients
const sseClients = new Set();

// SSE endpoint
app.get('/api/stream', (req, res) => {
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache');
  res.setHeader('Connection', 'keep-alive');

  const sendEvent = (event, data) => {
    res.write(`event: ${event}\n`);
    res.write(`data: ${JSON.stringify(data)}\n\n`);
  };

  // Send initial board state
  initDB().then(async () => {
    const board = await getBoardState();
    sendEvent('board-update', board);
  });

  // Add client to set
  sseClients.add(res);

  // Remove client from set on connection close
  req.on('close', () => {
    sseClients.delete(res);
  });
});

// Broadcast event to all SSE clients
function broadcast(event, data) {
  sseClients.forEach(client => {
    client.write(`event: ${event}\n`);
    client.write(`data: ${JSON.stringify(data)}\n\n`);
  });
}

// Get board state
async function getBoardState() {
  const columnsResult = await db.query(`
    SELECT c.id, c.title, c.position, 
           json_agg(json_build_object(
             'id', ca.id,
             'text', ca.text,
             'position', ca.position,
             'created_at', ca.created_at
           ) ORDER BY ca.position ASC) AS cards
    FROM columns c
    LEFT JOIN cards ca ON c.id = ca.column_id
    GROUP BY c.id
    ORDER BY c.position ASC;
  `);

  return columnsResult.rows;
}

// Board state endpoint
app.get('/api/board', async (req, res) => {
  const board = await getBoardState();
  res.json(board);
});

// Create card endpoint
app.post('/api/cards', async (req, res) => {
  const { columnId, text } = req.body;

  try {
    // Start transaction
    await db.begin();

    // Get the highest position in the target column
    const maxPositionResult = await db.query(
      'SELECT MAX(position) AS max_position FROM cards WHERE column_id = $1',
      [columnId]
    );

    const newPosition = (maxPositionResult.rows[0].max_position || -1) + 1;

    // Insert the new card
    const result = await db.query(
      'INSERT INTO cards (column_id, text, position) VALUES ($1, $2, $3) RETURNING *',
      [columnId, text, newPosition]
    );

    const card = result.rows[0];

    // Commit transaction
    await db.commit();

    // Broadcast the update
    const board = await getBoardState();
    broadcast('board-update', board);

    res.status(201).json(card);
  } catch (error) {
    // Rollback transaction on error
    await db.rollback();
    res.status(500).json({ error: 'Failed to create card' });
  }
});

// Move card endpoint
app.patch('/api/cards/:id/move', async (req, res) => {
  const { id } = req.params;
  const { columnId, beforeId, afterId } = req.body;

  try {
    // Start transaction
    await db.begin();

    // Get the card to move
    const cardResult = await db.query(
      'SELECT * FROM cards WHERE id = $1 FOR UPDATE',
      [id]
    );

    if (cardResult.rows.length === 0) {
      await db.rollback();
      return res.status(404).json({ error: 'Card not found' });
    }

    const card = cardResult.rows[0];

    // If moving to the same column and no before/after, do nothing
    if (card.column_id === columnId && beforeId === null && afterId === null) {
      await db.rollback();
      return res.status(200).json(card);
    }

    let newPosition;

    if (columnId !== card.column_id) {
      // Moving to a different column
      // Remove the card from its current column
      await db.query('DELETE FROM cards WHERE id = $1', [id]);

      // Get the highest position in the target column
      const maxPositionResult = await db.query(
        'SELECT MAX(position) AS max_position FROM cards WHERE column_id = $1',
        [columnId]
      );

      newPosition = (maxPositionResult.rows[0].max_position || -1) + 1;
    } else {
      // Moving within the same column
      if (beforeId && afterId) {
        // Get positions of before and after cards
        const beforeResult = await db.query(
          'SELECT position FROM cards WHERE id = $1',
          [beforeId]
        );
        const afterResult = await db.query(
          'SELECT position FROM cards WHERE id = $1',
          [afterId]
        );

        if (beforeResult.rows.length === 0 || afterResult.rows.length === 0) {
          await db.rollback();
          return res.status(400).json({ error: 'Invalid before or after card' });
        }

        const beforePosition = beforeResult.rows[0].position;
        const afterPosition = afterResult.rows[0].position;

        // Calculate new position between before and after
        newPosition = (beforePosition + afterPosition) / 2;
      } else if (beforeId) {
        // Insert before the specified card
        const beforeResult = await db.query(
          'SELECT position FROM cards WHERE id = $1',
          [beforeId]
        );

        if (beforeResult.rows.length === 0) {
          await db.rollback();
          return res.status(400).json({ error: 'Invalid before card' });
        }

        newPosition = beforeResult.rows[0].position - 0.5;
      } else if (afterId) {
        // Insert after the specified card
        const afterResult = await db.query(
          'SELECT position FROM cards WHERE id = $1',
          [afterId]
        );

        if (afterResult.rows.length === 0) {
          await db.rollback();
          return res.status(400).json({ error: 'Invalid after card' });
        }

        newPosition = afterResult.rows[0].position + 0.5;
      } else {
        // Append to the end of the column
        const maxPositionResult = await db.query(
          'SELECT MAX(position) AS max_position FROM cards WHERE column_id = $1',
          [columnId]
        );

        newPosition = (maxPositionResult.rows[0].max_position || -1) + 1;
      }
    }

    // Update the card's column and position
    const updateResult = await db.query(
      'UPDATE cards SET column_id = $1, position = $2 WHERE id = $3 RETURNING *',
      [columnId, newPosition, id]
    );

    const updatedCard = updateResult.rows[0];

    // Commit transaction
    await db.commit();

    // Broadcast the update
    const board = await getBoardState();
    broadcast('board-update', board);

    res.status(200).json(updatedCard);
  } catch (error) {
    // Rollback transaction on error
    await db.rollback();
    res.status(500).json({ error: 'Failed to move card' });
  }
});

// Start server
initDB().then(() => {
  app.listen(port, () => {
    console.log(`Server running at http://localhost:${port}`);
  });
});
```

