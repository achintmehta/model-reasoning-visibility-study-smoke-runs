 = []\nfor col in cols:\n    for card in col['cards']:\n        all_cards.append(card['id'])\nprint('Total card refs:', len(all_cards))\nprint('Unique cards:', len(set(all_cards)))\n\")\necho \"$DUPLICATES\"\n\necho \"\"\necho \"--- AC5: Reloading reproduces exact board state ---\"\n# Load the board twice and compare\nBOARD1=$(curl -s http://localhost:3000/api/board | python3 -c \"import sys,json; print(json.dumps(json.load(sys.stdin), sort_keys=True))\")\nsleep 0.5\nBOARD2=$(curl -s http://localhost:3000/api/board | python3 -c \"import sys,json; print(json.dumps(json.load(sys.stdin), sort_keys=True))\")\n\nif [ \"$BOARD1\" = \"$BOARD2\" ]; then\n  echo \"PASS: Board state is consistent across loads\"\nelse\n  echo \"FAIL: Board states differ\"\nfi\n\necho \"\"\necho \"--- AC6: Total stable ordering ---\"\n# Check no two cards share the same position in any column\necho \"$BOARD\" | python3 -c \"\nimport sys,json\ncols=json.load(sys.stdin)\nall_ok = True\nfor col in cols:\n    positions = [c['position'] for c in col['cards']]\n    if len(positions) != len(set(positions)):\n        print(f'FAIL: Duplicate positions in {col[\\\"title\\\"]}')\n        all_ok = False\n    else:\n        sorted_pos = sorted(positions)\n        if sorted_pos == positions:\n            print(f'PASS: {col[\\\"title\\\"]} has stable ordering')\n        else:\n            print(f'FAIL: {col[\\\"title\\\"]} not in position order')\n            all_ok = False\nif all_ok:\n    print('All columns have total stable ordering')\n\"\n\necho \"\"\necho \"=========================================\"\necho \"ALL TESTS COMPLETE\"\necho \"=========================================\""})
